# .claudeignore — files Claude should skip when processing this repo.
# Same syntax as .gitignore. One pattern per line; trailing whitespace ignored.

# --- Runtime state & secrets (NEVER read: contain user data + crypto keys) ---
# Encryption keys, password hashes, sessions, API-key hashes, TOTP secrets and
# user rows all live in the SQLite database and app.env.
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.env
.env.*
!.env.example
*.env
app.env

# --- Dependencies & build output (generated; read the source instead) --------
node_modules/
public/
dist/
build/
*.tsbuildinfo
bun.lock

# --- Logs -------------------------------------------------------------------
*.log

# --- Editor / IDE / OS noise ------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Git internals ----------------------------------------------------------
.git/objects/
.git/refs/
.git/logs/
.git/hooks/
.git/index
.git/COMMIT_EDITMSG
.git/description
.git/info/
