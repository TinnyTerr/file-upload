# One Sentry DSN per surface. Leave blank to turn that surface's reporting off.
# Copy to .env (gitignored).

# Browser app (client/) -- baked into the bundle at build time
SENTRY_DSN_WEB=
# Tauri desktop app (desktop/) -- baked into the webview bundle and the Rust binary
SENTRY_DSN_DESKTOP=
# Bun/Express server (server/) -- read at startup
SENTRY_DSN_SERVER=

# --- Sentry tuning (all optional) ---------------------------------------
# Fraction of requests / page loads traced (0..1). Server reads it at startup,
# the client bakes it into the bundle. Default 0.1.
SENTRY_TRACES_SAMPLE_RATE=
# Fraction of browser sessions recorded as replays (0..1). Sessions that hit an
# error are always recorded. Text, inputs and media are masked. Default 0.05.
SENTRY_REPLAY_SAMPLE_RATE=

# Source maps + release + commits. Set all three at *build* time (a deploy/CI
# build) and `bun run build` uploads the maps, creates release
# fileupload@<version>+<git sha> -- the same name the server reports -- and
# attaches the repo's commits. Leave blank for a plain offline build.
# Commit linking needs the repo connected in Sentry (Settings -> Integrations).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=
# Self-hosted Sentry only
SENTRY_URL=
