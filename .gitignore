# --- Dependencies -----------------------------------------------------------
node_modules/
.pnp/
.pnp.js

# Only the root lockfile is authoritative: `bun install` inside client/ or
# server/ resolves the workspace root, so a nested lock is a stale second
# answer that nothing reads.
client/bun.lock
server/bun.lock
client/package-lock.json
server/package-lock.json
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Build output -----------------------------------------------------------
# The client is built into public/ at deploy time (`bun run build`).
public/
dist/
build/
*.tsbuildinfo

# --- Runtime state & secrets ------------------------------------------------
# app.env (SECRET_KEY, MASTER_KEY_B64, API tokens), the SQLite database, stored
# blobs, thumbnails and torrent staging all live here. Never commit any of it.
/data/
server/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.env
.env.*
!.env.example

# --- Logs & test output -----------------------------------------------------
*.log
npm-debug.log*
server.log
coverage/

# --- Editor / OS ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code local state ------------------------------------------------
.claude/settings.local.json
.claude/worktrees/
